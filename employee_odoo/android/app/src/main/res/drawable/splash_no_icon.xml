<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ always draws an icon on its system splash screen and offers no
     way to opt out. A fully transparent icon leaves a plain white screen, which
     reads as part of the splash video rather than a separate screen before it.
     The branding is the video itself, so nothing is lost. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
